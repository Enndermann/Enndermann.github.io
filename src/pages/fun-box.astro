---
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/layouts/Main.astro";

// 这里定义页面的元数据
const pageTitle = "Fun Box";
const pageDesc = "A random discovery from my collection.";
---

<Layout title={`${pageTitle} | ${SITE.title}`}>
  <Header activeNav="surprising-box" />

  <Main pageTitle={pageTitle} pageDesc={pageDesc}>
    <div class="mt-8 min-h-[300px]">
      <div
        id="surprise-container"
        class="border-skin-line bg-skin-card relative flex flex-col items-center justify-center rounded-lg border p-8 text-center shadow-lg transition-all"
      >
        <div id="loading-state" class="animate-pulse py-12">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="icon icon-tabler icon-tabler-box text-skin-accent size-16"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5"></path>
            <path d="M12 12l8 -4.5"></path>
            <path d="M12 12l0 9"></path>
            <path d="M12 12l-8 -4.5"></path>
          </svg>
          <p class="mt-4 text-lg font-medium">Opening the box...</p>
        </div>

        <div id="error-state" class="hidden py-8 text-red-500">
          <p class="text-xl font-bold">Oops!</p>
          <p id="error-message" class="mt-2 text-sm">Something went wrong.</p>
        </div>

        <div id="content-display" class="hidden w-full">
          <img
            id="result-image"
            class="mx-auto hidden max-h-[500px] rounded shadow-md"
            alt="Surprise"
          />

          <div id="result-text-wrapper" class="hidden w-full text-left">
            <h3
              id="file-name"
              class="text-skin-accent border-skin-line mb-4 border-b pb-2 text-center text-lg font-bold"
            >
            </h3>
            <pre
              id="result-text"
              class="bg-skin-fill max-h-[500px] w-full overflow-auto rounded p-4 font-mono text-sm leading-relaxed">
            </pre>
          </div>

          <a
            id="github-link"
            href="#"
            target="_blank"
            class="text-skin-base hover:text-skin-accent mt-6 inline-block text-sm opacity-70 hover:underline hover:opacity-100"
          >
            View on GitHub &rarr;
          </a>
        </div>
      </div>

      <div class="mt-8 flex justify-center">
        <button
          id="refresh-btn"
          class="group bg-skin-accent text-skin-inverted focus:ring-skin-accent flex items-center gap-2 rounded-full px-6 py-3 font-bold transition-transform hover:scale-105 focus:ring-2 focus:ring-offset-2 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="icon icon-tabler icon-tabler-dice size-6 transition-transform group-hover:rotate-180"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path
              d="M3 3m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z"
            ></path>
            <circle cx="8.5" cy="8.5" r=".5" fill="currentColor"></circle>
            <circle cx="15.5" cy="8.5" r=".5" fill="currentColor"></circle>
            <circle cx="15.5" cy="15.5" r=".5" fill="currentColor"></circle>
            <circle cx="8.5" cy="15.5" r=".5" fill="currentColor"></circle>
          </svg>
          Surprise Me!
        </button>
      </div>
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  // ==========================================
  // 🔧 配置区域 (请修改这里)
  // ==========================================
  const CONFIG = {
    // 生产环境 GitHub Raw 地址 (请替换为你自己的)
    // format: https://raw.githubusercontent.com/<user>/<repo>/<branch>/<path-to-json>
    productionUrl:
      "https://raw.githubusercontent.com/Enndermann/Enndermann.github.io/Babel_astro/public/fun-box.json",

    // 本地测试数据地址 (相对于 public 目录)
    devUrl: "/fun-box-test.json", // TODO: 部署前请改回 productionUrl 或根据环境判断
  };
  // ==========================================

  // DOM 元素引用
  const els = {
    container: document.getElementById("surprise-container"),
    loading: document.getElementById("loading-state"),
    error: document.getElementById("error-state"),
    errorMsg: document.getElementById("error-message"),
    content: document.getElementById("content-display"),
    img: document.getElementById("result-image") as HTMLImageElement,
    textWrapper: document.getElementById("result-text-wrapper") as HTMLElement,
    fileName: document.getElementById("file-name") as HTMLElement, // Reused as Title
    textPre: document.getElementById("result-text") as HTMLElement,
    btn: document.getElementById("refresh-btn") as HTMLButtonElement,
    githubLink: document.getElementById("github-link") as HTMLAnchorElement,
  };

  /**
   * 获取内容列表
   */
  async function fetchContentList() {
    // 优先使用 devUrl 进行测试，正式上线建议切换逻辑或只保留 productionUrl
    // 此时为了方便用户测试验证，我们先默认 fetch 本地生成的测试文件
    // 如果用户要把这个部署到 Github Pages，需要确保 public/fun-box.json 存在
    // 这里我们简单做个判断：如果是 localhost 我们试着 fetch devUrl

    const isDev =
      window.location.hostname === "localhost" ||
      window.location.hostname === "127.0.0.1";
    // NOTE: 这里为了演示方便，先硬编码读取 CONFIG.devUrl。
    // 实际使用时，请根据需要修改。按照 Plan，我们先用测试数据验证。
    const url = CONFIG.devUrl;

    try {
      const res = await fetch(url);
      if (!res.ok) {
        throw new Error(`Failed to load content list: ${res.statusText}`);
      }
      const data = await res.json();
      if (!Array.isArray(data) || data.length === 0) {
        throw new Error("Content list is empty or invalid.");
      }
      return data;
    } catch (err: any) {
      throw err;
    }
  }

  /**
   * 主逻辑：随机获取并渲染
   */
  async function surpriseMe() {
    // 1. 重置 UI 状态
    setLoading(true);
    setError(null);

    try {
      // 2. 获取列表
      const contentList = await fetchContentList();

      // 3. 随机选择一个
      const randomItem =
        contentList[Math.floor(Math.random() * contentList.length)];

      // 4. 渲染内容
      await renderContent(randomItem);
    } catch (err: any) {
      setError(err.message || "Unknown error occurred.");
    } finally {
      setLoading(false);
    }
  }

  /**
   * 渲染内容
   */
  async function renderContent(item: any) {
    // 隐藏所有特定内容容器
    els.img.classList.add("hidden");
    els.textWrapper.classList.add("hidden");

    // 如果有 title 则显示，否则隐藏
    if (els.fileName) {
      els.fileName.innerText = item.title || "Surprise!";
    }

    // 处理 Link (可选)
    if (item.link) {
      els.githubLink.href = item.link;
      els.githubLink.innerText = "View Related Link →";
      els.githubLink.classList.remove("hidden");
    } else {
      els.githubLink.classList.add("hidden");
    }

    switch (item.type) {
      case "image":
        if (!item.url) throw new Error("Image URL is missing.");
        els.img.src = item.url;
        els.img.alt = item.title || "Random Image";
        els.img.classList.remove("hidden");

        // 等待图片加载
        await new Promise((resolve, reject) => {
          if (els.img.complete) return resolve(true);
          els.img.onload = resolve;
          els.img.onerror = () => reject(new Error("Failed to load image."));
        });
        break;

      case "text":
        if (!item.content) throw new Error("Text content is missing.");
        if (els.textPre) {
          els.textPre.textContent = item.content;
          // 复用 textWrapper
          els.textWrapper.classList.remove("hidden");
        }
        break;

      case "svg":
        if (!item.content) throw new Error("SVG content is missing.");
        // SVG 我们直接放在 textWrapper 里，或者动态插入
        // 为了简单，我们复用 textWrapper，但是清除 pre 样式或者直接插入 HTML
        // 这里我们稍微 HACK 一下，把 SVG 放入 result-text (pre) 的父级或者替换它
        // 更好的做法是增加一个 svg 容器

        // 让我们简单调整一下：如果是 SVG，我们临时把 content 当作 HTML 插入
        // 但要注意安全。这里假设源是可信的。
        if (els.textPre) {
          els.textPre.innerHTML = item.content; // Render SVG
          // 去除一些 PRE 的样式影响 ?
          // 保持简单，SVG 在 PRE 里面显示也可以，但最好是 DIV
          // 我们这里把 outerHTML 替换掉可能比较暴力，所以简单点，我们清空内容插进去
          // 或者为了通用性，我们在 HTML 结构里加一个 svg-container 更好，
          // 但为了少改 HTML，我们直接用 textWrapper
        }
        els.textWrapper.classList.remove("hidden");
        break;

      default:
        throw new Error(`Unknown content type: ${item.type}`);
    }

    // 显示整个内容区
    if (els.content) els.content.classList.remove("hidden");
  }

  // === UI 辅助函数 ===

  function setLoading(isLoading: boolean) {
    if (isLoading) {
      els.loading?.classList.remove("hidden");
      els.content?.classList.add("hidden");
      els.error?.classList.add("hidden");
      if (els.btn) {
        els.btn.disabled = true;
        els.btn.classList.add("opacity-70", "cursor-wait");
      }
    } else {
      els.loading?.classList.add("hidden");
      if (els.btn) {
        els.btn.disabled = false;
        els.btn.classList.remove("opacity-70", "cursor-wait");
      }
    }
  }

  function setError(msg: string | null) {
    if (msg) {
      if (els.errorMsg) els.errorMsg.innerText = msg;
      els.error?.classList.remove("hidden");
      els.content?.classList.add("hidden");
    } else {
      els.error?.classList.add("hidden");
    }
  }

  // === 初始化 ===

  // 页面加载时自动运行一次
  surpriseMe();

  // 绑定按钮点击事件
  els.btn?.addEventListener("click", surpriseMe);

  // 兼容 Astro View Transitions
  document.addEventListener("astro:after-swap", () => {
    // 简单重新绑定
    const cleanBtn = document.getElementById("refresh-btn");
    cleanBtn?.addEventListener("click", surpriseMe);
  });
</script>
